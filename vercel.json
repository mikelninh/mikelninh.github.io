{
  "version": 2,
  "functions": {
    "api/charly.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/zaitgeist-v3/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/zaitgeist-v3",
      "destination": "/zaitgeist-v3/index.html"
    },
    {
      "source": "/zaitgeist-v3/",
      "destination": "/zaitgeist-v3/index.html"
    },
    {
      "source": "/zaitgeist-v2",
      "destination": "/zaitgeist-v2/index.html"
    },
    {
      "source": "/zaitgeist-v2/",
      "destination": "/zaitgeist-v2/index.html"
    }
  ]
}
